# Copiar este archivo como .env y reemplazar los valores de ejemplo.
# El archivo .env NO se versiona.

# ---------- SQL Server ----------
# La contraseña debe cumplir la política de SQL Server:
# mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos.
MSSQL_SA_PASSWORD=Cambiar_Esta_Clave_123!
MSSQL_PORT=1433

# ---------- API (.NET) ----------
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
# Dentro de docker-compose el host de la BD es el nombre del servicio (db).
ConnectionStrings__DefaultConnection=Server=db,1433;Database=Mundialito;User Id=sa;Password=Cambiar_Esta_Clave_123!;TrustServerCertificate=True

# ---------- Frontend (Next.js) ----------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
