    {
      "name": "3. Partidos",
      "description": "Creación de partidos, registro de resultado (idempotente) y filtros por fecha, equipo y estado.",
      "item": [
        {
          "name": "Listar partidos jugados (filtro por estado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Todos están jugados', () => pm.response.json().data.forEach(m => pm.expect(m.status).to.eql('Played')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/matches?status=Played&sortBy=scheduledAt&sortDirection=desc&pageNumber=1&pageSize=10"
          }
        },
        {
          "name": "Filtrar por equipo y rango de fechas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const teamId = pm.environment.get('rivalTeamId');",
                  "pm.test('Todos los partidos son del equipo (local o visitante)', () => {",
                  "  pm.response.json().data.forEach(m => pm.expect([m.homeTeamId, m.awayTeamId]).to.include(teamId));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/matches?teamId={{rivalTeamId}}&from=2020-01-01&to=2030-12-31&pageNumber=1&pageSize=10"
          }
        },
        {
          "name": "Programar partido (POST idempotente)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('matchKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const match = pm.response.json();",
                  "pm.test('Queda programado', () => pm.expect(match.status).to.eql('Scheduled'));",
                  "pm.environment.set('matchId', match.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{matchKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"homeTeamId\": \"{{teamId}}\",\n  \"awayTeamId\": \"{{rivalTeamId}}\",\n  \"scheduledAt\": \"2026-11-01T18:00:00\",\n  \"venue\": \"Cancha principal\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/matches"
          }
        },
        {
          "name": "Detalle del partido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Todavía sin goles', () => pm.expect(pm.response.json().goals).to.be.an('array').that.is.empty);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/matches/{{matchId}}"
          }
        },
        {
          "name": "Registrar resultado (POST idempotente)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('resultKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const match = pm.response.json();",
                  "pm.test('Partido jugado 1 - 0 con su goleador', () => {",
                  "  pm.expect(match.status).to.eql('Played');",
                  "  pm.expect(match.homeGoals).to.eql(1);",
                  "  pm.expect(match.awayGoals).to.eql(0);",
                  "  pm.expect(match.goals).to.have.lengthOf(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{resultKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"homeGoals\": 1,\n  \"awayGoals\": 0,\n  \"goals\": [\n    { \"playerId\": \"{{playerId}}\", \"minute\": 30 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/matches/{{matchId}}/result"
          }
        },
        {
          "name": "Repetir registro con la misma key (misma respuesta)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Devuelve la respuesta original (200)', () => pm.response.to.have.status(200));",
                  "pm.test('Marcada como repetida', () => pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{resultKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"homeGoals\": 1,\n  \"awayGoals\": 0,\n  \"goals\": [\n    { \"playerId\": \"{{playerId}}\", \"minute\": 30 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/matches/{{matchId}}/result"
          }
        },
        {
          "name": "Registrar otra vez con key nueva (409 ya jugado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('Código Match.AlreadyPlayed', () => pm.expect(pm.response.json().code).to.eql('Match.AlreadyPlayed'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"homeGoals\": 1,\n  \"awayGoals\": 0,\n  \"goals\": [\n    { \"playerId\": \"{{playerId}}\", \"minute\": 30 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/matches/{{matchId}}/result"
          }
        }
      ]
    },
    {
      "name": "4. Tabla y goleadores",
      "description": "Tabla de posiciones (victoria 3, empate 1, derrota 0; orden: puntos → diferencia de gol → goles a favor) y goleadores, calculados con Dapper.",
      "item": [
        {
          "name": "Tabla de posiciones (orden oficial)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json().data;",
                  "pm.test('Orden oficial: puntos, diferencia de gol, goles a favor', () => {",
                  "  for (let i = 1; i < rows.length; i++) {",
                  "    const a = rows[i - 1], b = rows[i];",
                  "    const ordered = a.points > b.points",
                  "      || (a.points === b.points && a.goalDifference > b.goalDifference)",
                  "      || (a.points === b.points && a.goalDifference === b.goalDifference && a.goalsFor >= b.goalsFor);",
                  "    pm.expect(ordered, a.teamName + ' antes que ' + b.teamName).to.be.true;",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/standings"
          }
        },
        {
          "name": "Tabla ordenada por goles a favor",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json().data;",
                  "pm.test('Goles a favor de mayor a menor', () => {",
                  "  for (let i = 1; i < rows.length; i++) pm.expect(rows[i - 1].goalsFor).to.be.at.least(rows[i].goalsFor);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/standings?sortBy=goalsFor&sortDirection=desc"
          }
        },
        {
          "name": "Tabla paginada (página 2 de 2 en 2)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Página 2 con a lo sumo 2 filas', () => {",
                  "  pm.expect(body.pageNumber).to.eql(2);",
                  "  pm.expect(body.data.length).to.be.at.most(2);",
                  "  pm.expect(body.totalPages).to.eql(Math.ceil(body.totalRecords / 2));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/standings?pageNumber=2&pageSize=2"
          }
        },
        {
          "name": "Goleadores",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json().data;",
                  "pm.test('Ordenados por goles de mayor a menor', () => {",
                  "  for (let i = 1; i < rows.length; i++) pm.expect(rows[i - 1].goals).to.be.at.least(rows[i].goals);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
