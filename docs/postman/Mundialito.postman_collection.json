          "name": "Listar jugadores con filtros (posición) y orden por goles",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const players = pm.response.json().data;",
                  "pm.test('Todos son delanteros', () => players.forEach(p => pm.expect(p.position).to.eql('Forward')));",
                  "pm.test('Ordenados por goles de mayor a menor', () => {",
                  "  for (let i = 1; i < players.length; i++) pm.expect(players[i - 1].goals).to.be.at.least(players[i].goals);",
                  "});"
                ]
              }
            }
