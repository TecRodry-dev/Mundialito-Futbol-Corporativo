    {
      "name": "5. Idempotencia",
      "description": "Header Idempotency-Key en los POST: la key se guarda en la base; repetirla devuelve la misma respuesta sin duplicar; reutilizarla con otro payload devuelve 409; omitirla devuelve 400.",
      "item": [
        {
          "name": "Crear equipo con key nueva",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('idemTeamName', 'Idempotente FC ' + Date.now().toString().slice(-6));",
                  "pm.environment.set('idemKey', pm.variables.replaceIn('{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.environment.set('idemTeamId', pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idemKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{idemTeamName}}\",\n  \"coach\": \"Sofía Paredes\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/teams"
          }
        },
        {
          "name": "Repetir misma key y payload (misma respuesta)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Mismo status original (201)', () => pm.response.to.have.status(201));",
                  "pm.test('Mismo equipo, no se creó otro', () => pm.expect(pm.response.json().id).to.eql(pm.environment.get('idemTeamId')));",
                  "pm.test('Marcada como repetida', () => pm.expect(pm.response.headers.get('Idempotent-Replayed')).to.eql('true'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idemKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{idemTeamName}}\",\n  \"coach\": \"Sofía Paredes\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/teams"
          }
        },
        {
          "name": "Misma key con otro payload (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('Código Idempotency.KeyReused', () => pm.expect(pm.response.json().code).to.eql('Idempotency.KeyReused'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idemKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{idemTeamName}} B\",\n  \"coach\": \"Sofía Paredes\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/teams"
          }
        },
        {
          "name": "Sin header Idempotency-Key (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('Código Idempotency.KeyRequired', () => pm.expect(pm.response.json().code).to.eql('Idempotency.KeyRequired'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sin Key FC\",\n  \"coach\": \"Nadie\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/teams"
          }
        },
        {
          "name": "Verificar que no hubo duplicados",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Existe un solo equipo con ese nombre', () => pm.expect(pm.response.json().totalRecords).to.eql(1));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/teams?name={{idemTeamName}}"
          }
        }
      ]
    },
